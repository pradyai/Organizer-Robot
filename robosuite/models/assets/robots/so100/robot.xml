
<mujoco model="so_arm100">
  <option iterations="50" timestep="0.001" solver="PGS" gravity="0 0 -9.81" />

  <compiler angle="radian" meshdir="assets" eulerseq="zyx" autolimits="true" />

  <default>
    <joint limited="true" damping="0.01" armature="0.01" frictionloss="0.01" />
    <geom condim="4" contype="1" conaffinity="15" friction="0.9 0.2 0.2" solref="0.001 2" />
    <motor ctrllimited="true" />
    <equality solref="0.001 2" />
    <default class="visualgeom">
      <geom material="visualgeom" condim="1" contype="0" conaffinity="0" />
    </default>
  </default>

  <asset>
    <mesh name="Base" file="assets/Base.stl" />
    <mesh name="Rotation_Pitch" file="assets/Rotation_Pitch.stl" />
    <mesh name="Upper_Arm" file="assets/Upper_Arm.stl" />
    <mesh name="Lower_Arm" file="assets/Lower_Arm.stl" />
    <mesh name="Wrist_Pitch_Roll" file="assets/Wrist_Pitch_Roll.stl" />
    <texture name="texplane" type="2d" builtin="checker" rgb1=".0 .0 .0" rgb2=".8 .8 .8" width="100" height="100" />
    <material name="matplane" reflectance="0." texture="texplane" texrepeat="1 1" texuniform="true" />
    <material name="visualgeom" rgba="0.5 0.9 0.2 1" />
  </asset>

  <worldbody>
    <light directional="true" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" pos="0 0 5.0" dir="0 0 -1" castshadow="false" />
    <light directional="true" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1" />
    <geom name="ground" type="plane" pos="0 0 0" size="100 100 0.001" quat="1 0 0 0" material="matplane" condim="3" conaffinity="15" />
    <!-- <camera name="fixed" pos="0 -3.0 0.5382968451868893" xyaxes="1 0 0 0 0 1" />
    <camera name="track" mode="trackcom" pos="0 -3.0 0.5382968451868893" xyaxes="1 0 0 0 0 1" /> -->
    <camera mode="fixed" name="robotview" pos="1.0 0 0.4" quat="0.653 0.271 0.271 0.653"/>
    <body name="root" pos="0 0 0.03829684518688925" quat="1 0 0 0">
      <freejoint name="root" />
      <site name="imu" size="0.01" pos="0 0 0" />
      <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="Base" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
      <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="Base" />
      <body name="shoulder" pos="0 -0.0452 0.0165" quat="0.707109 0.707105 0 0">
        <inertial pos="-9.07886e-05 0.0590972 0.031089" mass="0.119226" diaginertia="5.94278e-05 5.89975e-05 3.13712e-05" />
        <joint name="shoulder_pan" pos="0 0 0" axis="0 1 0" range="-2 2" actuatorfrcrange="-35 35" />
        <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="Rotation_Pitch" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
        <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="Rotation_Pitch" />
        <body name="upper_arm" pos="0 0.1025 0.0306" quat="0.62161 -0.783327 0 0">
          <inertial pos="-1.72052e-05 0.0701802 0.00310545" mass="0.162409" diaginertia="0.000213312 0.000167164 7.01522e-05" />
          <joint name="shoulder_lift" pos="0 0 0" axis="1 0 0" range="0 3.5" actuatorfrcrange="-35 35" />
          <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="Upper_Arm" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
          <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="Upper_Arm" />
          <body name="lower_arm" pos="0 0.11257 0.028" quat="0.707109 0.707105 0 0">
            <inertial pos="-0.00339604 0.00137796 0.0768007" mass="0.147968" diaginertia="0.000138803 0.000107748 4.84242e-05" />
            <joint name="elbow_flex" pos="0 0 0" axis="1 0 0" range="-3.14158 0" actuatorfrcrange="-35 35" />
            <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="Lower_Arm" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
            <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="Lower_Arm" />
            <body name="wrist" pos="0 0.0052 0.1349" quat="0.877583 -0.479426 0 0">
              <inertial pos="-0.00852653 -0.0352279 -2.34622e-05" mass="0.0661321" diaginertia="3.45403e-05 2.39041e-05 1.94704e-05" />
              <joint name="wrist_flex" pos="0 0 0" axis="1 0 0" range="-2.5 1.2" actuatorfrcrange="-35 35" />
              <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="Wrist_Pitch_Roll" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
              <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="Wrist_Pitch_Roll" />
              <body name="gripper" pos="0 -0.0601 0" quat="0.707109 0 0.707105 0">
                <inertial pos="0.00552377 -0.0280167 0.000483583" mass="0.0929859" diaginertia="5.03136e-05 4.64098e-05 2.72961e-05" />
                <joint name="wrist_roll" pos="0 0 0" axis="0 1 0" range="-3.14158 3.14158" actuatorfrcrange="-35 35" />
                <body name="jaw" pos="-0.0202 -0.0244 0" quat="6.32679e-06 0 1 0">
                  <inertial pos="-0.00161745 -0.0303473 0.000449646" mass="0.0202444" diaginertia="1.11265e-05 8.99651e-06 2.99548e-06" />
                  <joint name="gripper" pos="0 0 0" axis="0 0 1" range="-0.2 2" actuatorfrcrange="-35 35" />
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="shoulder_pan" joint="shoulder_pan" ctrllimited="true" ctrlrange="-35 35" gear="1" />
    <motor name="shoulder_lift" joint="shoulder_lift" ctrllimited="true" ctrlrange="-35 35" gear="1" />
    <motor name="elbow_flex" joint="elbow_flex" ctrllimited="true" ctrlrange="-35 35" gear="1" />
    <motor name="wrist_flex" joint="wrist_flex" ctrllimited="true" ctrlrange="-35 35" gear="1" />
    <motor name="wrist_roll" joint="wrist_roll" ctrllimited="true" ctrlrange="-35 35" gear="1" />
    <motor name="gripper" joint="gripper" ctrllimited="true" ctrlrange="-35 35" gear="1" />
  </actuator>

  <sensor>
    <actuatorpos name="shoulder_pan_p" actuator="shoulder_pan" />
    <actuatorvel name="shoulder_pan_v" actuator="shoulder_pan" />
    <actuatorfrc name="shoulder_pan_f" actuator="shoulder_pan" noise="0.001" />
    <actuatorpos name="shoulder_lift_p" actuator="shoulder_lift" />
    <actuatorvel name="shoulder_lift_v" actuator="shoulder_lift" />
    <actuatorfrc name="shoulder_lift_f" actuator="shoulder_lift" noise="0.001" />
    <actuatorpos name="elbow_flex_p" actuator="elbow_flex" />
    <actuatorvel name="elbow_flex_v" actuator="elbow_flex" />
    <actuatorfrc name="elbow_flex_f" actuator="elbow_flex" noise="0.001" />
    <actuatorpos name="wrist_flex_p" actuator="wrist_flex" />
    <actuatorvel name="wrist_flex_v" actuator="wrist_flex" />
    <actuatorfrc name="wrist_flex_f" actuator="wrist_flex" noise="0.001" />
    <actuatorpos name="wrist_roll_p" actuator="wrist_roll" />
    <actuatorvel name="wrist_roll_v" actuator="wrist_roll" />
    <actuatorfrc name="wrist_roll_f" actuator="wrist_roll" noise="0.001" />
    <actuatorpos name="gripper_p" actuator="gripper" />
    <actuatorvel name="gripper_v" actuator="gripper" />
    <actuatorfrc name="gripper_f" actuator="gripper" noise="0.001" />
    <framequat name="orientation" objtype="site" noise="0.001" objname="imu" />
    <gyro name="angular-velocity" site="imu" noise="0.005" cutoff="34.9" />
  </sensor>
</mujoco>